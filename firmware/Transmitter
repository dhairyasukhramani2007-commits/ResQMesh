#include <Wire.h>
#include <Preferences.h>
#include <Adafruit_GFX.h>
#include <Adafruit_SSD1306.h>
#include <SPI.h>
#include <LoRa.h>

static const long RADIO_FREQ = 433E6;
static const int RADIO_SS = 5;
static const int RADIO_RST = 14;
static const int RADIO_DIO0 = 26;

static const char *NODE_ID = "NODE_01";
static const char *LOCATION_ID = "VILLAGE_A_SCHOOL";

static const unsigned long ACK_TIMEOUT_MS = 6500;
static const int MAX_ATTEMPTS = 3;

Adafruit_SSD1306 oled(128, 64, &Wire, -1);
Preferences prefs;

bool oledOK = false;
bool radioOK = false;

uint32_t counter = 0;


// Initializing LoRa
bool startRadio() {

  SPI.begin(18, 19, 23, RADIO_SS);

  LoRa.setPins(
    RADIO_SS,
    RADIO_RST,
    RADIO_DIO0
  );

  if (!LoRa.begin(RADIO_FREQ)) {
    return false;
  }

  LoRa.setSpreadingFactor(7);
  LoRa.setSignalBandwidth(125E3);
  LoRa.setCodingRate4(5);
  LoRa.setSyncWord(0x12);

  LoRa.receive();

  return true;
}


// Transmitting LoRa packet
bool radioSend(const String &message) {

  LoRa.idle();

  if (LoRa.beginPacket() != 1) {
    LoRa.receive();
    return false;
  }

  LoRa.print(message);

  bool ok = LoRa.endPacket() == 1;

  LoRa.receive();

  return ok;
}


// Splitting received packet
int splitFields(
  const String &line,
  String *fields,
  int capacity
) {

  int count = 0;
  int start = 0;

  for (unsigned int i = 0; i <= line.length(); i++) {

    if (i == line.length() || line[i] == ',') {

      if (count >= capacity) {
        return -1;
      }

      fields[count++] = line.substring(start, i);

      start = i + 1;
    }
  }

  return count;
}


// OLED display function
void screen(
  const String &a,
  const String &b = "",
  const String &c = "",
  const String &d = ""
) {

  Serial.println(
    a + " | " + b + " | " + c + " | " + d
  );

  if (!oledOK) {
    return;
  }

  oled.clearDisplay();

  oled.setTextSize(1);
  oled.setTextColor(SSD1306_WHITE);

  oled.setCursor(0, 0);
  oled.println(a);

  oled.setCursor(0, 16);
  oled.println(b);

  oled.setCursor(0, 32);
  oled.println(c);

  oled.setCursor(0, 48);
  oled.println(d);

  oled.display();
}


// Return to ready state
void ready() {

  digitalWrite(16, LOW);
  digitalWrite(17, LOW);

  if (radioOK) {

    screen(
      "RESQMESH READY",
      "SOS / MEDICAL",
      "RESCUE / SUPPLIES",
      "Mesh radio active"
    );

  } else {

    screen(
      "RESQMESH",
      "LORA ERROR",
      "Check SX1278"
    );
  }
}


// Waiting for gateway acknowledgement
bool waitForAck(const String &id) {

  unsigned long started = millis();

  LoRa.receive();

  while (millis() - started < ACK_TIMEOUT_MS) {

    if (LoRa.parsePacket() > 0) {

      String msg;

      while (LoRa.available()) {
        msg += (char)LoRa.read();
      }

      String fields[4];

      int count = splitFields(
        msg,
        fields,
        4
      );

      if (
        count == 4 &&
        fields[0] == "ACK" &&
        fields[1] == id
      ) {

        Serial.println(
          "GATEWAY ACK: " + msg
        );

        return true;
      }
    }

    delay(5);
  }

  return false;
}


// Sending emergency message
void sendEmergency(
  const char *kind,
  int priority
) {

  counter++;

  prefs.putUInt("seq", counter);

  String id =
    String(NODE_ID) + "-" + String(counter);

  // Format:
  // SOS,id,origin,type,priority,location,ttl,lastHop

  String msg =
    String("SOS,") +
    id + "," +
    NODE_ID + "," +
    kind + "," +
    String(priority) + "," +
    LOCATION_ID + ",4," +
    NODE_ID;

  digitalWrite(16, HIGH);
  digitalWrite(17, LOW);

  if (!radioOK) {

    screen(
      "LORA ERROR",
      "Cannot send"
    );

    delay(1800);

    ready();

    return;
  }

  bool ack = false;

  for (
    int attempt = 1;
    attempt <= MAX_ATTEMPTS;
    attempt++
  ) {

    screen(
      "SENDING " + String(kind),
      "Attempt " + String(attempt),
      "Waiting for",
      "gateway ACK..."
    );

    Serial.println(
      "TX: " + msg
    );

    if (
      radioSend(msg) &&
      waitForAck(id)
    ) {

      ack = true;

      break;
    }

    delay(random(200, 650));
  }

  if (ack) {

    digitalWrite(16, LOW);
    digitalWrite(17, HIGH);

    screen(
      "RESQMESH",
      kind,
      "GATEWAY RECEIVED",
      "ACK SUCCESS"
    );

  } else {

    screen(
      "RESQMESH",
      kind,
      "NO GATEWAY ACK",
      "Please retry"
    );
  }

  delay(2200);

  ready();
}


// Setup
void setup() {

  Serial.begin(115200);

  pinMode(25, INPUT_PULLUP);
  pinMode(27, INPUT_PULLUP);
  pinMode(32, INPUT_PULLUP);
  pinMode(4, INPUT_PULLUP);

  pinMode(16, OUTPUT);
  pinMode(17, OUTPUT);

  Wire.begin(21, 22);
  Wire.setClock(50000);

  oledOK = oled.begin(
    SSD1306_SWITCHCAPVCC,
    0x3C
  );

  screen(
    "RESQMESH",
    "Starting..."
  );

  prefs.begin(
    "resqmesh",
    false
  );

  counter = prefs.getUInt(
    "seq",
    0
  );

  randomSeed(esp_random());

  radioOK = startRadio();

  ready();
}


// Main loop
void loop() {

  int button = 0;

  if (digitalRead(25) == LOW) {
    button = 1;
  }

  else if (digitalRead(27) == LOW) {
    button = 2;
  }

  else if (digitalRead(32) == LOW) {
    button = 3;
  }

  else if (digitalRead(4) == LOW) {
    button = 4;
  }

  if (!button) {

    delay(15);

    return;
  }

  delay(40);

  int pin =
    button == 1 ? 25 :
    button == 2 ? 27 :
    button == 3 ? 32 : 4;

  if (digitalRead(pin) != LOW) {
    return;
  }

  if (button == 1) {
    sendEmergency("SOS", 1);
  }

  if (button == 2) {
    sendEmergency("MEDICAL", 1);
  }

  if (button == 3) {
    sendEmergency("RESCUE", 2);
  }

  if (button == 4) {
    sendEmergency("SUPPLIES", 3);
  }

  while (digitalRead(pin) == LOW) {
    delay(20);
  }
}


#include <SPI.h>
#include <LoRa.h>

// ==========================================
// RESQMESH - RELAY 2
// ESP32 + SX1278 LoRa Module
// ==========================================

// LoRa Configuration
static const long RADIO_FREQ = 433E6;

static const int RADIO_SS = 5;
static const int RADIO_RST = 14;
static const int RADIO_DIO0 = 26;

// Relay Identification
static const char *RELAY_ID = "RELAY_02";

// Duplicate Packet Protection
static const int CACHE_SIZE = 80;

static const unsigned long SOS_SUPPRESS_MS = 2000;
static const unsigned long ACK_SUPPRESS_MS = 1100;

String cachedKeys[CACHE_SIZE];

unsigned long cachedAt[CACHE_SIZE] = {0};

int nextCache = 0;


// ==========================================
// INITIALIZE LORA
// ==========================================

bool startRadio() {

  SPI.begin(18, 19, 23, RADIO_SS);

  LoRa.setPins(
    RADIO_SS,
    RADIO_RST,
    RADIO_DIO0
  );

  if (!LoRa.begin(RADIO_FREQ)) {
    return false;
  }

  LoRa.setSpreadingFactor(7);
  LoRa.setSignalBandwidth(125E3);
  LoRa.setCodingRate4(5);
  LoRa.setSyncWord(0x12);

  LoRa.receive();

  return true;
}


// ==========================================
// SEND LORA PACKET
// ==========================================

bool radioSend(const String &message) {

  LoRa.idle();

  if (LoRa.beginPacket() != 1) {

    LoRa.receive();

    return false;
  }

  LoRa.print(message);

  bool ok = LoRa.endPacket() == 1;

  LoRa.receive();

  return ok;
}


// ==========================================
// SPLIT CSV PACKET
// ==========================================

int splitFields(
  const String &line,
  String *fields,
  int capacity
) {

  int count = 0;
  int start = 0;

  for (
    unsigned int i = 0;
    i <= line.length();
    i++
  ) {

    if (
      i == line.length() ||
      line[i] == ','
    ) {

      if (count >= capacity) {
        return -1;
      }

      fields[count++] =
        line.substring(start, i);

      start = i + 1;
    }
  }

  return count;
}


// ==========================================
// VALIDATE TTL
// ==========================================

bool validNumber(
  const String &value,
  int &number
) {

  if (
    value.isEmpty() ||
    value.length() > 3
  ) {
    return false;
  }

  for (
    unsigned int i = 0;
    i < value.length();
    i++
  ) {

    if (
      value[i] < '0' ||
      value[i] > '9'
    ) {
      return false;
    }
  }

  number = value.toInt();

  return number >= 0 && number <= 20;
}


// ==========================================
// DUPLICATE PACKET SUPPRESSION
// ==========================================

bool recentlyForwarded(
  const String &key,
  unsigned long cooldown
) {

  unsigned long now = millis();

  for (int i = 0; i < CACHE_SIZE; i++) {

    if (
      cachedKeys[i] == key &&
      now - cachedAt[i] < cooldown
    ) {

      return true;
    }
  }

  cachedKeys[nextCache] = key;

  cachedAt[nextCache] = now;

  nextCache =
    (nextCache + 1) % CACHE_SIZE;

  return false;
}


// ==========================================
// SETUP
// ==========================================

void setup() {

  Serial.begin(115200);

  randomSeed(esp_random());

  Serial.println(
    String("Starting ") + RELAY_ID
  );

  if (!startRadio()) {

    Serial.println(
      "LORA INIT FAILED: check wiring / power"
    );

    while (true) {
      delay(1000);
    }
  }

  Serial.println(
    String(RELAY_ID) + " READY"
  );
}


// ==========================================
// MAIN LOOP
// ==========================================

void loop() {

  // Check for incoming LoRa packet
  if (LoRa.parsePacket() <= 0) {
    return;
  }

  String msg;

  while (LoRa.available()) {
    msg += (char)LoRa.read();
  }

  String fields[8];

  int count = splitFields(
    msg,
    fields,
    8
  );

  if (
    count != 8 &&
    count != 4
  ) {
    return;
  }

  bool sos =
    count == 8 &&
    fields[0] == "SOS";

  bool ack =
    count == 4 &&
    fields[0] == "ACK";

  if (!sos && !ack) {
    return;
  }

  if (fields[1].isEmpty()) {
    return;
  }

  int ttl = 0;

  int ttlIndex =
    sos ? 6 : 2;

  int hopIndex =
    sos ? 7 : 3;

  if (
    !validNumber(fields[ttlIndex], ttl) ||
    ttl <= 1
  ) {
    return;
  }

  // Prevent immediate packet loop
  if (fields[hopIndex] == RELAY_ID) {
    return;
  }

  if (
    sos &&
    (
      fields[2].isEmpty() ||
      fields[3].isEmpty()
    )
  ) {
    return;
  }

  String key =
    String(sos ? "S:" : "A:") +
    fields[1];

  // Check for duplicate packets
  if (
    recentlyForwarded(
      key,
      sos ? SOS_SUPPRESS_MS : ACK_SUPPRESS_MS
    )
  ) {

    Serial.println(
      "Duplicate suppressed: " + key
    );

    return;
  }

  // Random forwarding delay
  // Helps reduce packet collisions
  delay(random(120, 420));

  // Reduce TTL
  fields[ttlIndex] =
    String(ttl - 1);

  // Update last hop
  fields[hopIndex] =
    RELAY_ID;

  // Reconstruct packet
  String forwarded = fields[0];

  for (int i = 1; i < count; i++) {

    forwarded +=
      "," + fields[i];
  }

  // Display packet information
  Serial.println(
    "RX: " + msg
  );

  Serial.println(
    "TX: " + forwarded
  );

  // Forward packet
  if (radioSend(forwarded)) {

    Serial.println("FORWARDED");

  } else {

    Serial.println("TX FAILED");
  }
}
